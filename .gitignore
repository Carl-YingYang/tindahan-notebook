# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets or local config
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
server.log
*.pid

# sandbox / workspace artifacts (not part of the app)
/skills/
/examples/
/mini-services/
/tests/
/tool-results/
/download/
/upload/
/.zscripts/
/.qa/
/.qa3/
/.agent-browser/
/agent-ctx/
worklog.md
Caddyfile
prompt
test

# local runtime databases (created by `prisma db push`; seed runs automatically)
/db/*.db
/db/*.db-journal
